# Copy this to .env (next to docker-compose.yml) and fill it in.
# docker compose reads .env automatically - no need to source it yourself.

# Required: where the player pushes events. Each device's hierarchical
# path is appended to this to form that device's own endpoint.
WEBSOCKET_URL=ws://host:1880/ingest

# Optional - all have defaults in docker-compose.yml.

# Where --root and --playlist come from on the HOST. Both default to the
# bundled sample_data/sample_playlist.csv (relative to this file) so compose
# works with no setup; point these at your own data for real deployments -
# absolute paths, or paths relative to this .env file's directory.
# ASSETS_DIR=./sample_data
# PLAYLIST_FILE=./sample_playlist.csv

# API_PORT=8000
# DEFAULT_SPEED=1.0
# TICK=0.2
# WEBSOCKET_RETRY_DELAY=5.0
# LOG_LEVEL=INFO

# Where the daily-rotating log file (kept 3 days) is written on the HOST.
# Defaults to ./logs next to this file.
# LOGS_DIR=./logs
